{"rules":[{"effect":"deny","id":"no-spend-ever","locked":true,"note":"FIXTURE policy (synthetic). Locked: spending is refused outright.","when":"permission_class == 'SPEND'"},{"effect":"deny","id":"no-delete-ever","locked":true,"note":"FIXTURE policy (synthetic). Locked: deletes are refused outright.","when":"permission_class == 'DELETE'"},{"effect":"ask","id":"deploys-ask-for-routines","note":"Unattended (routine-initiated) deploys ask a human first.","when":"initiator == 'routine' && permission_class == 'DEPLOY'"},{"effect":"ask","id":"comms-ask","note":"Outbound communication asks first.","when":"permission_class == 'COMMUNICATE' && !approved"},{"effect":"ask","id":"network-ask","note":"Network-writing actions ask first.","when":"permission_class == 'NETWORK_WRITE' && !approved"},{"effect":"pre_approved","id":"docs-preapproved","note":"Standing approval for documentation writes under docs/.","when":"kind == 'fs.write' && startsWith(payload.path, 'docs/')"},{"effect":"allow","id":"allow-the-rest","note":"Everything else in the map is allowed.","when":"true"}]}